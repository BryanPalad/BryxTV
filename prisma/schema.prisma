generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// Models generated by the official Better Auth 1.7.12 CLI.
model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  watchlistItems WatchlistItem[]
  viewingProgress ViewingProgress[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum WatchlistMediaType {
  movie
  tv
}

model WatchlistItem {
  id        String @id @default(cuid())
  userId    String
  tmdbId    Int
  mediaType WatchlistMediaType
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tmdbId, mediaType])
  @@index([userId, createdAt, id])
  @@map("watchlist_item")
}

enum ViewingMediaType {
  movie
  tv
  demo
}

model ViewingProgress {
  id String @id @default(cuid())
  userId String
  contentKey String
  mediaType ViewingMediaType
  tmdbId Int?
  demoId String?
  seasonNumber Int?
  episodeNumber Int?
  positionSeconds Float
  durationSeconds Float
  completed Boolean @default(false)
  observedAt DateTime
  lastWatchedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, contentKey])
  @@index([userId, lastWatchedAt, id])
  @@index([userId, completed, lastWatchedAt])
  @@map("viewing_progress")
}

enum PlaybackSourceType {
  VIDEOJS_MP4
  VIDEOJS_HLS
  EXTERNAL_EMBED
}

enum PlaybackAvailability {
  AVAILABLE
  UNAVAILABLE
  UNKNOWN
}

model PlaybackProvider {
  id String @id @default(cuid())
  slug String @unique
  name String
  type PlaybackSourceType
  enabled Boolean @default(false)
  sources PlaybackSource[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("playback_provider")
}

model PlaybackSource {
  id String @id @default(cuid())
  providerId String
  provider PlaybackProvider @relation(fields: [providerId], references: [id], onDelete: Restrict)
  contentKey String
  tmdbId Int
  mediaType WatchlistMediaType
  seasonNumber Int?
  episodeNumber Int?
  sourceUrl String
  displayLabel String
  priority Int @default(100)
  enabled Boolean @default(false)
  authorizationVerified Boolean @default(false)
  authorizationEvidence String?
  availabilityStatus PlaybackAvailability @default(UNKNOWN)
  verificationEvidence String?
  lastCheckedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([providerId, contentKey, sourceUrl])
  @@index([contentKey, enabled, authorizationVerified, availabilityStatus, priority])
  @@index([mediaType, tmdbId, seasonNumber, episodeNumber])
  @@map("playback_source")
}
