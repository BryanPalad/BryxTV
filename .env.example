ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_SIGNING_KEY_ID=
MUX_SIGNING_PRIVATE_KEY=

TMDB_READ_ACCESS_TOKEN=