# Copy to .env.local. Keep all database and provider credentials server-only.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Private Vercel Preview setup: see .env.staging.example (server-only family list).
# Server-only credentials: never prefix these with NEXT_PUBLIC_.
# Neon pooled connection for application queries.
DATABASE_URL=
# Neon direct connection for Prisma CLI operations and future migrations.
DIRECT_URL=

# At least 32 characters. Keep server-only; never commit the actual value.
BETTER_AUTH_SECRET=
# Exact app origin, including dev port. Use HTTPS when deployed.
BETTER_AUTH_URL=http://localhost:3000
# Google OAuth Web application credentials (server-only).
# Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AniList public catalog queries require no key. Reserved for future OAuth:
ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_SIGNING_KEY_ID=
MUX_SIGNING_PRIVATE_KEY=

TMDB_READ_ACCESS_TOKEN=

# Server-only YouTube Data API v3 discovery key (standard free quota; no paid plan).
# Restrict the key to YouTube Data API v3. Never prefix it with NEXT_PUBLIC_.
# Without it, bulk discovery requires explicit --fixture; no live results are fabricated.
# Inactive: YouTube is excluded; not needed for application operation.
# YOUTUBE_API_KEY=
