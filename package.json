{
  "name": "bryxtv",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --conditions=react-server --import tsx --test tests/*.test.ts && npm run test:auth:ui",
    "postinstall": "prisma generate",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:check": "tsx scripts/check-db.ts",
    "staging:check": "node --import tsx scripts/check-staging.ts",
    "test:auth:integration": "node --conditions=react-server --import tsx --test tests/auth.integration.test.ts",
    "db:migrate:deploy": "prisma migrate deploy",
    "test:auth:ui": "node --import tsx --test tests/ui/*.test.tsx",
    "test:watchlist:integration": "node --conditions=react-server --import tsx --test tests/watchlist.integration.test.ts",
    "test:history:integration": "node --conditions=react-server --import tsx --test tests/history.integration.test.ts",
    "playback:manage": "node --conditions=react-server --import tsx scripts/playback-sources.ts",
    "test:playback:integration": "node --conditions=react-server --import tsx --test tests/playback-providers.integration.test.ts",
    "playback:discover": "node --import tsx scripts/discover-official-video.ts",
    "content:discover": "node --conditions=react-server --import tsx scripts/content-discover.ts",
    "content:review": "node --conditions=react-server --import tsx scripts/content-review.ts"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "1.7.12",
    "@hookform/resolvers": "6.0.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@videojs/hlsjs-video": "^10.2.0",
    "@videojs/react": "^10.2.0",
    "better-auth": "1.7.12",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.59.0",
    "motion": "^14.4.0",
    "next": "16.4.2",
    "pg": "8.23.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.90.0",
    "server-only": "^0.0.1",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@next/env": "16.4.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^20",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "auth": "1.7.12",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "jsdom": "^27.4.0",
    "prisma": "7.10.1",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  }
}
