# Reference only: Next does not automatically load .env.staging.
# Set these in the hosting project's Preview environment; never commit values.
# Keep NODE_ENV=production for deployed builds. This separate marker enables noindex.
BRYXTV_ENV=staging
# Server-only, comma-separated verified family identities. Replace placeholders.
STAGING_ALLOWED_EMAILS=email1@example.com,email2@example.com
NEXT_PUBLIC_APP_URL=https://YOUR-STABLE-STAGING-HOST
BETTER_AUTH_URL=https://YOUR-STABLE-STAGING-HOST
# Generate a new secret for staging; do not reuse production or development secrets.
BETTER_AUTH_SECRET=
# Neon pooled and direct URLs for the SAME non-production branch, with TLS.
DATABASE_URL=
DIRECT_URL=
# Independently confirm this ID in Neon before running staging:check.
# Dedicated staging branch required before family deployment; do not paste production.
STAGING_NEON_BRANCH_ID=
# Separate Google OAuth Web client; callback:
# https://YOUR-STABLE-STAGING-HOST/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TMDB_READ_ACCESS_TOKEN=
# No YouTube, Mux, or AniList credentials required.
# Deployment-level access protection is mandatory; this file does NOT enable it.
